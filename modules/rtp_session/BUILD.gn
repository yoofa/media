import("//base/build/ave.gni")

ave_library("packet_transport") {
  sources = [
    "transport/packet_transport.cc",
    "transport/packet_transport.h",
    "transport/packet_transport_sink.h",
    "transport/udp_packet_transport.cc",
    "transport/udp_packet_transport.h",
  ]

  deps = [
    "//base:timeutils",
    "//base:utils",
    "//base/units:timestamp",
  ]
}

ave_library("rtp_transport") {
  sources = [
    "transport/rtp_transport.cc",
    "transport/rtp_transport.h",
  ]

  deps = [
    ":packet_transport",
    ":srtp_session",
    "//base:timeutils",
    "//base:utils",
    "//media/modules/rtp_rtcp:transport",
  ]
}

ave_library("rtp_session") {
  sources = [
    "audio_packet_buffer.cc",
    "audio_packet_buffer.h",
    "audio_rtp_receive_stream.cc",
    "audio_rtp_receive_stream.h",
    "audio_rtp_send_stream.cc",
    "audio_rtp_send_stream.h",
    "rtp_session.cc",
    "rtp_session.h",
    "rtp_timestamp_mapper.cc",
    "rtp_timestamp_mapper.h",
    "video_rtp_send_stream.cc",
    "video_rtp_send_stream.h",
  ]

  deps = [
    ":rtp_transport",
    "//base:clock",
    "//base/numerics:sequence_number_unwrapper",
    "//base:utils",
    "//base/units:timestamp",
    "//media/foundation:media_frame",
    "//media/foundation:media_source_sink",
    "//media/foundation:avc_util",
    "//media/foundation/h264",
    "//media/modules/rtp_rtcp:receive_statistics_impl",
    "//media/modules/rtp_rtcp:rtp_header_extension_map",
    "//media/modules/rtp_rtcp:rtp_header_extensions",
    "//media/modules/rtp_rtcp:rtp_packet",
    "//media/modules/rtp_rtcp:rtp_packet_received",
    "//media/modules/rtp_rtcp:rtp_rtcp_format",
    "//media/modules/rtp_rtcp:rtp_rtcp_interface",
    "//media/modules/rtp_rtcp:rtp_sender_audio",
    "//media/modules/rtp_rtcp:rtp_sender_video",
  ]
}

ave_library("srtp_session") {
  sources = [
    "security/srtp_session.cc",
    "security/srtp_session.h",
  ]

  deps = [
    "//base:utils",
    "//third_party/libsrtp",
  ]
}

if (!is_android) {
  ave_source_set("unittest_sources") {
    testonly = true
    sources = [
      "audio_rtp_receive_stream_unittest.cc",
      "rtp_session_unittest.cc",
      "security/srtp_session_unittest.cc",
      "transport/packet_transport_unittest.cc",
      "video_rtp_send_stream_unittest.cc",
    ]
    deps = [
      ":packet_transport",
      ":rtp_session",
      ":rtp_transport",
      ":srtp_session",
      "//base:clock",
      "//base:task_util",
      "//media/modules/rtp_rtcp:rtp_packet_received",
      "//media/modules/rtp_rtcp:rtp_rtcp_impl2",
      "//media/modules/rtp_rtcp:transport",
      "//test:test_support",
    ]
  }

  ave_executable("rtp_session_unittests") {
    testonly = true
    deps = [
      ":unittest_sources",
      "//test:test_main",
    ]
  }
}
